---
import { buildLogoAlignedForm } from "./lib/hero-form.js";
import "./test.logo.css";

const title = "Theater im Depot — first view motion prototype";
const initialFormPath = buildLogoAlignedForm(1440, 900);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={title} />
    <title>{title}</title>
  </head>
  <body>
    <main class="stage" data-motion-stage aria-label="Motion prototype">
      <div class="teaser" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1324 756"
          width="100%"
          height="100%"
          preserveAspectRatio="none"
        >
          <defs>
            <mask id="stage">
              <rect width="100%" height="100%"></rect>
              <path
                id="ellipse"
                d="M1169.4,261.3c0,28-12.8,54.7-36,79.2c-6.5,6.9-13.9,13.6-22.1,20.1c-9.2,7.4-19.4,14.5-30.5,21.3
	c-5.6,3.4-11.3,6.8-17.3,10c-11.6,6.3-24,12.3-37.1,18c-6.5,2.8-13.3,5.6-20.2,8.3c-17.3,6.7-35.7,12.9-55,18.6
	c-7,2.1-14.2,4-21.5,6c-17.5,4.6-35.8,8.7-54.6,12.4c-6.2,1.2-12.5,2.4-18.9,3.5c-21.7,3.8-44.2,7-67.3,9.5
	c-4.3,0.5-8.5,0.9-12.8,1.3c-31.2,3-63.6,4.8-96.8,5.3c-5.7,0.1-11.4,0.1-17.2,0.1c-44.1,0-87-2.4-127.8-6.8
	c-6.9-0.8-13.8-1.6-20.6-2.4c-18-2.3-35.6-5-52.8-8.2c-5.3-1-10.5-2-15.7-3c-14.5-2.9-28.5-6-42.2-9.5c-8.3-2.1-16.5-4.3-24.5-6.5
	c-21.6-6.2-42.1-13-61.2-20.5c-6.8-2.7-13.5-5.4-19.9-8.2c-12.5-5.5-24.4-11.2-35.5-17.2c-11.1-6-21.5-12.3-31.1-18.7
	c-4.4-3-8.6-6-12.7-9.1c-8.4-6.4-16.1-13-23-19.8c-26-25.7-40.3-54-40.3-83.7c0-41.4,27.9-80.1,76.3-112.8
	C320.7,88,480.2,47.7,662.1,47.7c166.3,0,314,33.7,406.5,85.8C1131.9,169.1,1169.4,213.4,1169.4,261.3L1169.4,261.3z"
              ></path>
              <path id="form" style="visibility: hidden" d={initialFormPath}></path>
            </mask>
            <clipPath id="inneroutline">
              <use href="#ellipse"></use>
            </clipPath>
          </defs>
          <path class="outer" mask="url(#stage)" d="M1324.12,756H.12V0H1324.12V756Z"></path>
        </svg>
      </div>

      <div class="logo" data-logo>
        <svg
          class="full"
          viewBox="0 0 1371 370"
          preserveAspectRatio="none"
          role="img"
          aria-label="Theater im Depot"
        >
          <image
            href="/images/logo.svg"
            x="0"
            y="0"
            width="1371"
            height="370"
            preserveAspectRatio="none"
          />
        </svg>
      </div>
      <p class="hint" data-hint>
        click anywhere
      </p>
    </main>

    <script>
      import KUTE from "kute.js";
      import { createHeroMorph } from "./lib/hero-motion.js";
      import { buildLogoAlignedForm } from "./lib/hero-form.js";

      const stage = document.querySelector("[data-motion-stage]");
      const logo = document.querySelector("[data-logo]");
      const ellipse = document.querySelector("#ellipse");
      const form = document.querySelector("#form");
      const hint = document.querySelector("[data-hint]");
      let toPath = buildLogoAlignedForm(window.innerWidth, window.innerHeight);
      let heroTween;
      let opened = false;

      const prepareMorph = () => {
        if (opened) return;
        toPath = buildLogoAlignedForm(window.innerWidth, window.innerHeight);
        form.setAttribute("d", toPath);
        heroTween = createHeroMorph(KUTE, ellipse, form);
      };

      prepareMorph();
      window.addEventListener("resize", prepareMorph);

      const open = () => {
        if (opened) return;
        opened = true;
        document.body.classList.add("open");
        logo.classList.add("open");
        stage.dataset.open = "true";
        hint.setAttribute("aria-hidden", "true");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          ellipse.setAttribute("d", toPath);
          return;
        }

        heroTween.start();
      };

      window.addEventListener("click", open, { once: true });
    </script>
  </body>
</html>
